<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_text }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <style>
    :root{
      --c-text: {{ settings.color_text }};
      --c-muted: {{ settings.color_muted }};
      --c-bg: {{ settings.color_background }};
      --c-soft: {{ settings.color_soft }};
      --c-accent: {{ settings.color_accent }};
      --c-sale: {{ settings.color_sale }};
      --f-body: 'Inter', Helvetica, Arial, sans-serif;
      --f-serif: 'Cormorant Garamond', Georgia, serif;
      --f-heading: {% if settings.heading_style == 'serif' %}var(--f-serif){% else %}var(--f-body){% endif %};
      --header-h: 64px;
      --gutter: {{ settings.page_gutter }}px;
    }
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <script>window.theme={routes:{cart_add_url:'{{ routes.cart_add_url }}',cart_change_url:'{{ routes.cart_change_url }}',cart_url:'{{ routes.cart_url }}',root:'{{ routes.root_url }}'},strings:{added:{{ 'cart.added' | t | json }},soldOut:{{ 'products.sold_out' | t | json }},addToCart:{{ 'products.add_to_cart' | t | json }}},moneyFormat:{{ shop.money_format | json }}};</script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body data-cart-type="{{ settings.cart_type }}" class="template-{{ template.name }}{% if template.name == 'index' and settings.transparent_header %} has-transparent-header{% endif %}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
  <div class="overlay" data-overlay></div>
</body>
</html>
