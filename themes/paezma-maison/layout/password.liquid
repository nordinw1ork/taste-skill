<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <style>:root{--c-text:{{ settings.color_text }};--c-muted:{{ settings.color_muted }};--c-bg:{{ settings.color_background }};--c-soft:{{ settings.color_soft }};--c-accent:{{ settings.color_accent }};--c-sale:{{ settings.color_sale }};--f-body:'Inter',Helvetica,Arial,sans-serif;--f-serif:'Cormorant Garamond',Georgia,serif;--f-heading:{% if settings.heading_style == 'serif' %}var(--f-serif){% else %}var(--f-body){% endif %};--gutter:{{ settings.page_gutter }}px;--header-h:64px}</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
