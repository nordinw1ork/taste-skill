<div class="cart-item">
  <a href="{{ item.url }}" class="cart-item__img">
    {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
  </a>
  <div>
    <div class="cart-item__top">
      <a href="{{ item.url }}">{{ item.product.title }}</a>
      <span>{%- if item.original_line_price > item.final_line_price -%}<s class="muted">{{ item.original_line_price | money }}</s> {% endif %}{{ item.final_line_price | money }}</span>
    </div>
    <div class="cart-item__opts">
      {%- unless item.product.has_only_default_variant -%}{{ item.variant.title }}{%- endunless -%}
      {%- for p in item.properties -%}{%- unless p.last == blank or p.first contains '_' -%}<br>{{ p.first }}: {{ p.last }}{%- endunless -%}{%- endfor -%}
      {%- if item.selling_plan_allocation -%}<br>{{ item.selling_plan_allocation.selling_plan.name }}{%- endif -%}
      {%- for d in item.line_level_discount_allocations -%}<br>{{ d.discount_application.title }} (-{{ d.amount | money }}){%- endfor -%}
    </div>
    <div class="cart-item__bottom">
      <div class="qty">
        <button type="button" data-line-qty="-1" data-key="{{ item.key }}" aria-label="-">−</button>
        <input type="number" min="0" value="{{ item.quantity }}" data-line-input="{{ item.key }}" aria-label="{{ 'products.quantity' | t }}">
        <button type="button" data-line-qty="1" data-key="{{ item.key }}" aria-label="+">+</button>
      </div>
      <button type="button" class="cart-item__remove" data-line-remove="{{ item.key }}">{{ 'cart.remove' | t }}</button>
    </div>
  </div>
</div>
