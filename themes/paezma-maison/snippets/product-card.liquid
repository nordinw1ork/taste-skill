{%- comment -%} Params: product, lazy (bool) {%- endcomment -%}
{%- liquid
  case settings.card_ratio
    when 'square'
      assign ratio = '1/1'
    when 'tall'
      assign ratio = '2/3'
    else
      assign ratio = '3/4'
  endcase
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}
{%- if product != blank -%}
<div class="card" style="--card-ratio:{{ ratio }}">
  <a href="{{ product.url }}" class="card__media" aria-label="{{ product.title | escape }}">
    {%- if product.available == false -%}
      <span class="card__badge">{{ 'products.sold_out' | t }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="card__badge card__badge--sale">{{ 'products.sale' | t }}</span>
    {%- elsif product.tags contains 'new' or product.tags contains 'nuevo' -%}
      <span class="card__badge">{{ 'products.new' | t }}</span>
    {%- endif -%}
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: loading, sizes: '(min-width: 990px) 25vw, 50vw', widths: '360,540,720,900', alt: product.featured_media.alt | default: product.title, class: 'img-1' }}
      {%- if settings.card_show_second_image and product.media[1] -%}
        {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '360,540,720,900', alt: '', class: 'img-2' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  {%- if settings.card_quick_add and product.available -%}
    <div class="card__quick">
      {%- if product.has_only_default_variant -%}
        <div class="card__quick-opts"><button type="button" data-quick-add="{{ product.selected_or_first_available_variant.id }}" style="width:100%">{{ 'products.add_to_cart' | t }}</button></div>
      {%- elsif product.options.size == 1 and product.variants.size <= 12 -%}
        <p>{{ 'products.choose' | t }}</p>
        <div class="card__quick-opts">
          {%- for v in product.variants -%}
            <button type="button" data-quick-add="{{ v.id }}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}</button>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="card__quick-opts"><a class="btn btn--outline btn--full" style="min-height:34px" href="{{ product.url }}">{{ 'products.choose' | t }}</a></div>
      {%- endif -%}
    </div>
  {%- endif -%}
  <a href="{{ product.url }}" class="card__info">
    <div>
      <h3 class="card__title">{{ product.title }}</h3>
      {%- assign color_opt = product.options_with_values | where: 'name', 'Color' | first -%}
      {%- if color_opt == blank -%}{%- assign color_opt = product.options_with_values | where: 'name', 'Colour' | first -%}{%- endif -%}
      {%- if color_opt and color_opt.values.size > 1 -%}
        <div class="card__sub">{{ color_opt.values.size }} {{ color_opt.name | downcase }}</div>
      {%- elsif product.metafields.custom.material != blank -%}
        <div class="card__sub">{{ product.metafields.custom.material }}</div>
      {%- endif -%}
    </div>
    <div class="card__price">{% render 'price', product: product, use_range: true %}</div>
  </a>
</div>
{%- endif -%}
