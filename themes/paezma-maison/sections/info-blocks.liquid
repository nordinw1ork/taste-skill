<section class="section" style="--pt:{{ section.settings.pt }}px;--pb:{{ section.settings.pb }}px;--pt-m:{{ section.settings.pt_m }}px;--pb-m:{{ section.settings.pb_m }}px;background:{{ section.settings.bg }}">
  {%- if section.settings.title != blank -%}<h2 class="t-center" style="margin-bottom:32px" data-reveal>{{ section.settings.title }}</h2>{%- endif -%}
  <div class="info__grid" style="--cols:{{ section.settings.cols }}">
    {%- for block in section.blocks -%}
      <div class="info__item" data-reveal {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '#' }}" class="media-cover" style="display:block">
          {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '600,900,1200,1400', alt: block.settings.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </a>
        <div class="info__row">
          <p class="info__title">{{ block.settings.title }}</p>
          <div class="muted rte">{{ block.settings.col_1 }}</div>
          <div class="muted rte">{{ block.settings.col_2 }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Bloques de información",
  "settings": [
    { "type": "text", "id": "title", "label": "Título" },
    { "type": "range", "id": "cols", "label": "Columnas", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "pt", "label": "Margen superior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "pb", "label": "Margen inferior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "pt_m", "label": "Margen superior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "pb_m", "label": "Margen inferior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "item", "name": "Bloque", "settings": [
      { "type": "image_picker", "id": "image", "label": "Imagen" },
      { "type": "text", "id": "title", "label": "Título", "default": "Nuestro taller" },
      { "type": "richtext", "id": "col_1", "label": "Columna 1", "default": "<p>Diseñado en España</p><p>Piezas hechas a mano</p>" },
      { "type": "richtext", "id": "col_2", "label": "Columna 2", "default": "<p>Atención personalizada</p><p>Lunes – Viernes 10.00 – 18.00</p>" },
      { "type": "url", "id": "link", "label": "Enlace" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "Bloques de información", "blocks": [ { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
