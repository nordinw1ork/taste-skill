<section class="section" style="--pt:{{ section.settings.pt }}px;--pb:{{ section.settings.pb }}px;--pt-m:{{ section.settings.pt_m }}px;--pb-m:{{ section.settings.pb_m }}px">
  <div class="editorial{% if section.settings.layout == 'content-media' %} reverse{% endif %}{% if section.settings.mobile_content_first %} m-content-first{% endif %}" style="background:{{ section.settings.bg }}">
    <div class="editorial__media">
      <div class="media-cover">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false }}
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '600,900,1200,1600', alt: section.settings.image.alt }}
        {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
      </div>
    </div>
    <div class="editorial__content">
      <div class="editorial__inner" style="text-align:{{ section.settings.align }}" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<div class="uc muted" style="font-size:11px;margin-bottom:12px">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        <div class="rte">{{ section.settings.text }}</div>
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.link }}" class="btn-link">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Editorial",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "video", "id": "video", "label": "Vídeo (opcional)" },
    { "type": "select", "id": "layout", "label": "Distribución", "options": [ { "value": "media-content", "label": "Imagen a la izquierda" }, { "value": "content-media", "label": "Imagen a la derecha" } ], "default": "content-media" },
    { "type": "checkbox", "id": "mobile_content_first", "label": "Texto primero en móvil", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "title", "label": "Título", "default": "La colección" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Piezas pensadas para acompañarte cada día: siluetas delicadas, materiales nobles y un acabado que perdura.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Descubrir la colección" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "select", "id": "align", "label": "Alineación", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "pt", "label": "Margen superior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb", "label": "Margen inferior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pt_m", "label": "Margen superior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb_m", "label": "Margen inferior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [ { "name": "Editorial" } ]
}
{% endschema %}
