<section class="section" style="--pt:{{ section.settings.pt }}px;--pb:{{ section.settings.pb }}px;--pt-m:{{ section.settings.pt_m }}px;--pb-m:{{ section.settings.pb_m }}px">
  <div class="lib" style="--h:{{ section.settings.height }}vh">
    {%- if section.settings.link != blank -%}<a class="fsm__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.title | escape }}"></a>{%- endif -%}
    <div class="media-cover">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '900,1400,1800,2400', class: 'desktop-only', alt: section.settings.image.alt }}
        {%- assign mimg = section.settings.image_mobile | default: section.settings.image -%}
        {{ mimg | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '100vw', widths: '600,900,1200', class: 'mobile-only', alt: mimg.alt }}
      {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
    </div>
    <div class="fsm__overlay" style="opacity:{{ section.settings.overlay | divided_by: 100.0 }}"></div>
    <div class="lib__content{% if section.settings.center %} center{% endif %}" style="color:{{ section.settings.color }}" data-reveal>
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.link }}" class="btn-link white" style="position:relative;z-index:2">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Banner horizontal",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagen móvil" },
    { "type": "range", "id": "height", "label": "Altura", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 75 },
    { "type": "range", "id": "overlay", "label": "Oscurecer imagen", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 15 },
    { "type": "text", "id": "title", "label": "Título", "default": "El lookbook" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver lookbook" },
    { "type": "url", "id": "link", "label": "Enlace" },
    { "type": "checkbox", "id": "center", "label": "Texto centrado", "default": false },
    { "type": "color", "id": "color", "label": "Color del texto", "default": "#FFFFFF" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "pt", "label": "Margen superior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb", "label": "Margen inferior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pt_m", "label": "Margen superior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "pb_m", "label": "Margen inferior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [ { "name": "Banner horizontal" } ]
}
{% endschema %}
