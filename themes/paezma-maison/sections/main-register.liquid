<div class="account">
  <h1>{{ 'customer.create' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="RFirst">{{ 'customer.first_name' | t }}</label><input id="RFirst" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="RLast">{{ 'customer.last_name' | t }}</label><input id="RLast" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="REmail">{{ 'customer.email' | t }}</label><input id="REmail" type="email" name="customer[email]" required autocomplete="email"></div>
    <div class="field"><label for="RPass">{{ 'customer.password' | t }}</label><input id="RPass" type="password" name="customer[password]" required autocomplete="new-password"></div>
    <button class="btn btn--full">{{ 'customer.register' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Registro", "settings": [] }
{% endschema %}
