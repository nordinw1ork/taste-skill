<section class="section cats{% if section.settings.label_overlay %} cats--overlay{% endif %}" style="--pt:{{ section.settings.pt }}px;--pb:{{ section.settings.pb }}px;--pt-m:{{ section.settings.pt_m }}px;--pb-m:{{ section.settings.pb_m }}px">
  {%- if section.settings.title != blank -%}<h2 class="cats__title t-center" data-reveal>{{ section.settings.title }}</h2>{%- endif -%}
  <div class="cats__grid" style="--cols:{{ section.settings.cols }};--cols-m:{{ section.settings.cols_m }}">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign url = block.settings.link | default: c.url | default: '#' -%}
      {%- assign img = block.settings.image | default: c.featured_image -%}
      {%- assign label = block.settings.label | default: c.title | default: 'Categoría' -%}
      <a href="{{ url }}" class="cats__item" data-reveal style="transition-delay:{{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
        <div class="media-cover" style="aspect-ratio:{{ section.settings.ratio }}">
          {%- if img -%}{{ img | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 25vw, 50vw', widths: '400,600,800,1000', alt: label }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        </div>
        <div class="cats__label t-center"><span class="btn-link">{{ label }}</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Categorías destacadas",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Nuestras piezas firma" },
    { "type": "range", "id": "cols", "label": "Columnas escritorio", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "cols_m", "label": "Columnas móvil", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "select", "id": "ratio", "label": "Proporción", "options": [ { "value": "3/4", "label": "3:4" }, { "value": "1/1", "label": "1:1" }, { "value": "2/3", "label": "2:3" }, { "value": "4/5", "label": "4:5" } ], "default": "3/4" },
    { "type": "checkbox", "id": "label_overlay", "label": "Texto sobre la imagen", "default": false },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "pt", "label": "Margen superior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 30 },
    { "type": "range", "id": "pb", "label": "Margen inferior", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 30 },
    { "type": "range", "id": "pt_m", "label": "Margen superior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 50 },
    { "type": "range", "id": "pb_m", "label": "Margen inferior (móvil)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 50 }
  ],
  "blocks": [
    { "type": "category", "name": "Categoría", "settings": [
      { "type": "collection", "id": "collection", "label": "Colección" },
      { "type": "image_picker", "id": "image", "label": "Imagen (opcional)" },
      { "type": "text", "id": "label", "label": "Texto (opcional)" },
      { "type": "url", "id": "link", "label": "Enlace (opcional)" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Categorías destacadas", "blocks": [ { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" } ] } ]
}
{% endschema %}
