<div class="account">
  <h1>{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="NPass">{{ 'customer.password' | t }}</label><input type="password" id="NPass" name="customer[password]" required autocomplete="new-password"></div>
    <div class="field"><label for="NPass2">{{ 'customer.password' | t }}</label><input type="password" id="NPass2" name="customer[password_confirmation]" required autocomplete="new-password"></div>
    <button class="btn btn--full">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Restablecer contraseña", "settings": [] }
{% endschema %}
