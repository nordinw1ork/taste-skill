<div class="fsm" style="color:#fff">
  <div class="media-cover">{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 2400 | image_tag: sizes: '100vw', widths: '900,1400,2400', alt: shop.name }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</div>
  <div class="fsm__overlay" style="opacity:.3"></div>
  <div class="fsm__content v-center" style="pointer-events:auto;padding-top:0">
    <div class="header__logo" style="font-size:28px;margin-bottom:22px">{{ shop.name }}</div>
    <h1 class="fsm__title">{{ section.settings.title }}</h1>
    {%- if shop.password_message != blank -%}<p class="fsm__text">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p>{{ 'newsletter.success' | t }}</p>{%- else -%}
      <div style="display:flex;border-bottom:1px solid #fff;min-width:min(380px,85vw)"><input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" style="flex:1;border:0;height:46px;outline:0;background:transparent;color:#fff"><button type="submit" class="uc" style="color:#fff;font-size:11.5px">{{ 'newsletter.subscribe' | t }}</button></div>
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top:40px">
      <summary class="uc" style="cursor:pointer;font-size:11px">{{ 'general.enter_password' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <div style="display:flex;gap:8px;margin-top:12px"><input type="password" name="password" class="input" placeholder="{{ 'general.password' | t }}" style="color:#000"><button type="submit" class="btn btn--pill">{{ 'general.enter' | t }}</button></div>
      {%- endform -%}
    </details>
  </div>
</div>
{% schema %}
{
  "name": "Contraseña",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "text", "id": "title", "label": "Título", "default": "Muy pronto" }
  ]
}
{% endschema %}
